# 라즈베리파이 자동 실행 설정 (systemd 서비스, 2026-10-12)
#
# 하는 일
#   부팅하면 센서 수집 프로그램을 자동으로 실행하고,
#   프로그램이 죽으면 10초 뒤 다시 살린다.
#
# 설치 위치: /etc/systemd/system/plant-collector.service
# 설치 방법은 261012_자동실행_설정방법.txt 참고
#
# 사용자 이름이 pi 가 아니면 User / WorkingDirectory / ExecStart 의 경로를 바꿀 것

[Unit]
Description=Plant sensor collector (Arduino -> CSV)
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/261009_pi_collector.py

# 프로그램이 어떤 이유로든 멈추면 10초 뒤 다시 실행
Restart=always
RestartSec=10

# print 내용이 바로 로그에 남도록 (버퍼링 끄기)
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
